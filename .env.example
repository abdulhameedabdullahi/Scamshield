# ScamShield — environment variable template
# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored and must NEVER be committed.

# reCAPTCHA Enterprise site key (the PUBLIC key shown in the reCAPTCHA admin console).
# This is NOT the secret key. Create a reCAPTCHA Enterprise key at:
#   https://console.cloud.google.com/security/recaptcha
# Then register it in the Firebase console under App Check → Apps.
VITE_RECAPTCHA_SITE_KEY=

# App Check debug token for localhost development (a secret — keep it out of source).
# How to get one:
#   1. Leave this blank for the first run. The Firebase App Check SDK will
#      auto-generate a random token and print it in the browser console:
#        [Firebase] App Check debug token: <uuid>
#   2. Copy that UUID and register it in the Firebase console:
#        App Check → Apps → your web app → Manage debug tokens → Add
#   3. Paste the UUID here so it stays stable across dev server restarts.
# If left blank, a new random token is generated on each run (you would need
# to register a new one each time, which is tedious).
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Google Safe Browsing API key (free, 10 000 lookups/day).
# Create one at: https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
# Enable the "Safe Browsing API" then create an API key with no restrictions for server use.
# Leave blank to skip Safe Browsing checks (analyzeLink will fall back to heuristics only).
VITE_SAFE_BROWSING_API_KEY=
